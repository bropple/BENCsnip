# Build artifacts
*.o
*.d
*.a
build/
dist/
bencsnip
bencsnip-probe
bencsnip-test
mkembed
src/core/sn_embed.c
*.exe
*.res.o
.ffmpeg-prefix

# Third-party libraries built or copied in locally. raylib and ffmpeg are
# build dependencies, not part of this project's source - see the Makefile for
# how they are found, and README.md for how to put one here.
# Built prefixes get dropped in here and are not source. The one exception is
# a single vendored header that is: see vendor/stb.
vendor/*
!vendor/stb/

# Brand/style assets, kept out of the public repo.
style/

# Someone's edit is their work, not the project's.
projects/
*.bencsnip

# Anything the program exported, and the clips it was given.
exports/
media/

# Screenshots the program writes for itself.
shots/
/*.png
!docs/*.png

# A clip dropped in the top of the tree to try something out. Footage is
# somebody's own and is nearly always large; media/ is ignored for the same
# reason, and this is the same mistake made one directory up.
/*.gif
/*.mp4
/*.mov
/*.webm

# OS cruft
.DS_Store
._*

# Screenshots and recordings dropped in for reference. Not source.
screenshots/
